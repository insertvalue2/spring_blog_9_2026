{{> layout/header}}

<div class="container p-5">

    {{#boardPage.list}}
        <div class="card mb-3">
            <div class="card-body">
                <h4 class="card-title mb-3">{{title}}</h4>
                <p class="text-muted">
                    작성자: {{username}} | 작성일: {{createdAt}}
                </p>
                <a href="/board/{{id}}" class="btn btn-primary">상세보기</a>
            </div>
        </div>
    {{/boardPage.list}}

    {{^boardPage.list}}
        <div class="text-center mt-5">
            <h5>등록된 게시글이 없습니다</h5>
            <p class="text-muted">첫 번째 게시글을 작성해보세요!</p>
            <a href="/board/save" class="btn btn-primary">새글쓰기</a>
        </div>
    {{/boardPage.list}}

    {{#boardPage.totalElements}}
    <!-- 페이지 네비게이션 -->
    <ul class="pagination d-flex justify-content-center">
        <!-- 이전 페이지 버튼 (첫 페이지면 disabled) -->
        <li class="page-item {{#boardPage.first}}disabled{{/boardPage.first}}">
            <a class="page-link" href="/?page={{boardPage.prevPage}}&size={{boardPage.size}}">이전</a>
        </li>

        <!-- 페이지 번호 윈도우 (현재 페이지 기준 앞뒤 2페이지) -->
        <!-- pageNumbers는 PageItem(number, active) 목록 -->
        {{#boardPage.pageNumbers}}
            <li class="page-item {{#active}}active{{/active}}">
                <a class="page-link" href="/?page={{number}}&size={{boardPage.size}}">{{number}}</a>
            </li>
        {{/boardPage.pageNumbers}}

        <!-- 다음 페이지 버튼 (마지막 페이지면 disabled) -->
        <li class="page-item {{#boardPage.last}}disabled{{/boardPage.last}}">
            <a class="page-link" href="/?page={{boardPage.nextPage}}&size={{boardPage.size}}">다음</a>
        </li>
    </ul>
    {{/boardPage.totalElements}}

</div>

{{> layout/footer}}
